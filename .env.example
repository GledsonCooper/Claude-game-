# Copie este arquivo para .env e preencha.
PORT=3000

# ---- PayPal (cartão de crédito/débito + conta PayPal) ----
# Crie em https://developer.paypal.com/dashboard/applications
# Use "sandbox" para testar e "live" para receber dinheiro de verdade.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---- Pix via Mercado Pago ----
# Access Token em https://www.mercadopago.com.br/developers/panel/app
# (credenciais de produção começam com APP_USR-)
MP_ACCESS_TOKEN=

# Senha para ver o relatório de vendas em /api/admin/stats?key=SUA_SENHA
ADMIN_KEY=troque-esta-senha

# Modo demo (compras grátis para teste). Fica ligado automaticamente
# quando nenhum meio de pagamento está configurado.
# DEMO_PURCHASES=false

# ---- Google Play (app Android) ----
# Nome do pacote do app (o mesmo cadastrado no Play Console)
GOOGLE_PLAY_PACKAGE=br.com.coopercloud.pulim
# Conta de serviço do Google Cloud com acesso ao Play Console (veja PLAY_STORE.md, etapa 6).
# Pode ser o caminho do arquivo .json, o JSON inteiro em uma linha, ou o JSON em base64.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Impressão digital SHA-256 do certificado de assinatura do app (Play Console > Integridade do app).
# Se tiver mais de uma (chave de upload + chave do Google), separe por vírgula.
TWA_SHA256_FINGERPRINTS=

# ---- Dados da empresa (aparecem na Política de Privacidade e nos Termos) ----
COMPANY_CNPJ=00.000.000/0001-00
COMPANY_ADDRESS=Rua Exemplo, 123 - Cidade/UF
SUPPORT_EMAIL=suporte@seudominio.com.br
